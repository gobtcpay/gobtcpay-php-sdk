# Credentials for the OPT-IN integration tests (composer test:integration).
# Copy to `.env` (gitignored) or export in your shell. Use TEST-CONTOUR
# values only — never a production terminal secret.

# Per-terminal HMAC secret on the test contour.
POS_API_KEY=

# A POS terminal id registered on the test contour.
POS_TERMINAL_ID=

# API base URL. Defaults to the dev/test contour if unset.
POS_API_BASE_URL=https://pay.dev.gobtcpay.com/public/api/v1.1

# Merchant secret key (sk_live_…) for the server-side client. Optional; only
# needed to exercise the GoBTCPayServer integration flow.
GOBTCPAY_SECRET_KEY=sk_live_...

# Optional: webhook signing secret, to exercise webhook verification live.
POS_WEBHOOK_SECRET=
